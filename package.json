{
  "name": "@local/dsh-memory",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "记忆系统：设置页「记忆管理」+ 给模型一行中立状态",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mounta1n-18/dsh-memory.git"
  },
  "homepage": "https://github.com/mounta1n-18/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/mounta1n-18/dsh-memory/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
